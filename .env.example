# Copy to .env and change the passwords and the JWT secret before running.

# PostgreSQL container
POSTGRES_DB=atelier
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change-me

# Backend connection to the database
DB_HOST=db
DB_PORT=5432
DB_NAME=atelier
DB_USER=atelier
DB_PASSWORD=change-me

# JWT signing key: use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-to-a-long-random-string
